<oap:target id="pom-project">
  <oap:target id="model-version">4.0.0</oap:target>

  <oap:target id="parent-block">
    <parent>
      <oap:target id="parent-group-id">org.springframework.boot</oap:target>
      <oap:target id="parent-artifact-id">spring-boot-starter-parent</oap:target>
